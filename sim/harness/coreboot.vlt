`verilator_config

// sim/harness/coreboot_main.cpp watches the CPU as tb/tb_cpu.sv does in the
// CPU bench: the writeback stage for retired instructions and exceptions,
// the register file, the PC of the instruction at the memory stage.
public_flat_rd -module "zap_writeback" -var "i_valid"
public_flat_rd -module "zap_writeback" -var "i_decompile_valid"
public_flat_rd -module "zap_writeback" -var "i_uop_last"
public_flat_rd -module "zap_writeback" -var "i_data_abt"
public_flat_rd -module "zap_writeback" -var "i_fiq"
public_flat_rd -module "zap_writeback" -var "i_irq"
public_flat_rd -module "zap_writeback" -var "i_instr_abt"
public_flat_rd -module "zap_writeback" -var "i_swi"
public_flat_rd -module "zap_writeback" -var "i_und"
public_flat_rd -module "zap_writeback" -var "i_pc_plus_8_buf_ff"
public_flat_rd -module "zap_writeback" -var "cpsr_ff"
public_flat_rd -module "zap_register_file" -var "mem"
public_flat_rd -module "zap_core" -var "postalu_pc_plus_8_ff"

// Architectural events use the same wrapper taps as hardware counters.
public_flat_rd -module "emu" -var "tr_wb_*"
public_flat_rd -module "arm9v2_core" -var "data_pc8"

// Cycle-model profiling; observation only, no RTL feedback.
public_flat_rd -module "emu" -var "cpu_dbg_stall"
public_flat_rd -module "emu" -var "cpu_dbg_dcache"
public_flat_rd -module "emu" -var "cpu_dbg_icache"
public_flat_rd -module "arm9v2_core" -var "request"
public_flat_rd -module "arm9v2_core" -var "request_done"
public_flat_rd -module "arm9v2_core" -var "i_data_fill_busy"
public_flat_rd -module "arm9v2_core" -var "o_data_wb_we"

// --check-flash and --buslog: the burst kind on the CPU's port, and each
// flash chip's state (in read-array mode, with no command sequence, program
// or erase, its reads equal the image).
public_flat_rd -module "emu" -var "wb_cti"
public_flat_rd -module "nor_flash" -var "mode"
public_flat_rd -module "nor_flash" -var "cseq"
public_flat_rd -module "nor_flash" -var "p_state"
public_flat_rd -module "nor_flash" -var "e_state"

// --check-window: every load from the C: drive's aliases checked against the
// live flash image: the data port's completion (the uncached alias answers
// there; a cached-alias hit too) and the cache's background register write
// (a cached-alias miss: the FSM's saved address names the line).
public_flat_rd -module "emu" -var "tr_d_done"
public_flat_rd -module "emu" -var "tr_d_we"
public_flat_rd -module "emu" -var "tr_d_va"
public_flat_rd -module "emu" -var "tr_d_rdata"
public_flat_rd -module "zap_dcache_fsm" -var "address"
public_flat_rd -module "zap_dcache_fsm" -var "reg_dat_ff"
public_flat_rd -module "zap_dcache_fsm" -var "o_reg_idx"
