+// ARM925T: resolve the one-bit access outcome before selecting the domain.
+// The saved fault summary need not wait for the encoded FSR and its reduction.
+// Keep the full FSR functions below for the architecturally reported status.
+function automatic access_fault(input user, rd, wr, input [1:0] ap, sr,
+                                input [15:0][1:0] dac_reg, input [3:0] domain);
+        logic [15:0] denied;
+        logic ap_denied;
+        ap_denied = is_apsr_ok(user, rd, wr, {ap, sr}) != APSR_OK;
+        for (int d = 0; d < 16; d++)
+                denied[d] = dac_reg[d] != DAC_MANAGER &&
+                            (dac_reg[d] != DAC_CLIENT || ap_denied);
+        return denied[domain];
+endfunction
+
 function automatic [7:0] get_fsr_fpage (           // Return 0 means OK to access else is a valid FSR.
 input                   user, rd, wr,              // Access properties.
 input [1:0]             sr,                        // S and R bits.
