index 0000000..da3de5e
--- /dev/null
+++ b/tools/report_timing5_families.tcl
@@ -0,0 +1,76 @@
+# Loaded after create_timing_netlist/read_sdc/update_timing_netlist.
+# Report matching register sets even when a family leaves the worst 30.
+# Empty from/to means unconstrained on that side.
+set found_corner 0
+foreach_in_collection corner [get_available_operating_conditions] {
+    if {[get_operating_conditions_info -display_name $corner] eq "Slow 1100mV 100C Model"} {
+        set_operating_conditions $corner
+        update_timing_netlist
+        set found_corner 1
+    }
+}
+if {!$found_corner} { error "Missing slow 100C corner" }
+set families {
+    icvalid_input {} {*u_code_cache*valid_s1* *u_code_cache*valid_part* *u_code_cache*lru_s1* *u_code_cache*lru_part* *u_code_cache*rd_hi_s1*}
+    icvalid_output {*u_code_cache*valid_s1* *u_code_cache*valid_part* *u_code_cache*lru_s1* *u_code_cache*lru_part* *u_code_cache*rd_hi_s1*} {*u_code_cache*valid_s2* *u_code_cache*lru_s2*}
+    dcvalid_input {} {*u_data_cache*valid_s1* *u_data_cache*valid_part* *u_data_cache*lru_s1* *u_data_cache*lru_part* *u_data_cache*rd_hi_s1*}
+    multiply {*u_zap_issue_main*o_alu_operation_ff* *u_zap_issue_main*o_alu_is_mult_ff*} {*u_zap_shifter_main*}
+    multiply_output {*u_zap_issue_main*o_alu_operation_ff* *u_zap_issue_main*o_alu_is_mult_ff*} {*u_zap_shifter_main|o_*}
+    dtlb_fault {*u_data_cache*u_zap_tlb_check*o_fsr*} {}
+    dtlb_fault_capture {} {*u_data_cache*u_zap_tlb_check*o_fsr*}
+    itlb_fault_capture {} {*u_code_cache*u_zap_tlb_check*o_fsr*}
+    dtlb_check_input {} {*u_data_cache*u_zap_tlb_check*o_fsr* *u_data_cache*u_zap_tlb_check*o_hit_ok*}
+    itlb_check_input {} {*u_code_cache*u_zap_tlb_check*o_fsr* *u_code_cache*u_zap_tlb_check*o_hit_ok*}
+    load_valid_input {} {*zap_postalu_main*o_load_valid_ff* *zap_postalu_main*o_dav_ff* *zap_postalu_main*o_mem_load_ff*}
+    issue_operand_select {} {*u_zap_issue_main*alu_source_select_ff* *u_zap_issue_main*shift_source_select_ff* *u_zap_issue_main*shift_length_select_ff* *u_zap_issue_main*mem_srcdest_select_ff*}
+    issue_forward {} {*u_zap_issue_main*alu_source_normal_ff* *u_zap_issue_main*shift_source_normal_ff* *u_zap_issue_main*shift_length_normal_ff* *u_zap_issue_main*saved_special_ff*}
+    card_model {*mmc_card*} {*mmc_card*}
+    itlb_fault {*u_code_cache*u_zap_tlb_check*o_fsr*} {}
+    issue_stall {*u_zap_issue_main*stall*} {*u_zap_issue_main*}
+    issue_feedback {} {*u_zap_issue_main*stall_idx_ff* *u_zap_issue_main*stall_late_ff* *u_zap_issue_main*stall_lock_ff* *u_zap_issue_main*o_stall_from_issue*}
+    issue_stall_feedback {*u_zap_issue_main*stall*} {*u_zap_issue_main*stall_idx_ff* *u_zap_issue_main*stall_late_ff* *u_zap_issue_main*stall_lock_ff* *u_zap_issue_main*o_stall_from_issue*}
+    issue_pending {} {*u_zap_issue_main*o_load_pending_ff* *u_zap_issue_main*o_shift_source_pending_ff* *u_zap_issue_main*o_shift_length_pending_ff*}
+    decode_pending {*u_zap_decode_main*o_shift_length_ff*} {*u_zap_issue_main*o_load_pending_ff*}
+    issue_store {} {*u_zap_issue_main*mem_srcdest_normal_ff* *u_zap_issue_main*mem_srcdest_select_ff*}
+    arbiter_control {*test_on_q* *arb*sel_* *arb*gnt*} {*upp_bus*}
+    bus_address {*zap_wb_merger*o_wb_adr*} {*upp_bus*}
+    bus_register_inputs {} {*upp_bus*}
+    bus_input {} {*upp_bus*adr_q* *upp_bus*dat_q* *upp_bus*fe_* *upp_bus*sdr_addr*}
+    bl_decode {*zap_predecode_main*o_instruction_ff* *zap_predecode_main*o_bl*} {*u_zap_decode_main*}
+    merger_inputs {} {*zap_wb_merger*}
+    dcache_tag_inputs {} {*u_data_cache*u_zap_cache_fsm*reg_idx* *u_data_cache*u_zap_cache_fsm*reg_valid*}
+    dcache_bus {*u_data_cache*u_zap_cache_fsm*state_ff*} {*zap_wb_merger*o_wb_adr*}
+    predecode_payload {} {*zap_predecode_main*o_ppc_ff* *zap_predecode_main*o_pc_from_decode* *zap_predecode_main*ras_ptr_ff* *zap_predecode_main*prediction*ff*}
+    prediction_output {*zap_predecode_main*o_ppc_ff* *zap_predecode_main*o_pc_from_decode* *zap_predecode_main*prediction*ff*} {}
+    predecode_und {} {*zap_predecode_main*o_v5_und_ff* *zap_predecode_main*saved_class_ff* *zap_predecode_main*saved_thumb_bl_ff*}
+    cache_stall_pipeline {*u_data_cache* *u_zap_cp15_cb*o_mmu_en*} {*u_zap_core*}
+    cache_stall_to_core {*u_data_cache* *u_zap_cp15_cb*o_mmu_en*} {*u_zap_alu_main|* *u_zap_shifter_main|*}
+    background_pickup {*u_data_cache*u_zap_cache_fsm*o_reg_idx* *u_data_cache*u_zap_cache_fsm*o_reg_valid*} {*u_zap_alu_main|* *u_zap_shifter_main|*}
+    shifter_output {} {*u_zap_shifter_main*o_shifted_source_value_ff* *u_zap_shifter_main*o_shift_carry_ff* *u_zap_shifter_main*o_shift_sat_ff*}
+    predecode_copro {} {*zap_predecode_main*copro_word*ff* *zap_predecode_coproc*cp_word_ff*}
+    fifo_control {} {*u_zap_sync_fifo*empty_ff* *u_zap_sync_fifo*full_ff* *u_zap_sync_fifo*wptr_ff* *u_zap_sync_fifo*rptr_ff*}
+    issue_to_decode {*u_zap_issue_main*} {*u_zap_decode_main*}
+}
+file mkdir build/timing5-families
+set family_summary [open build/timing5-families/slacks.tsv w]
+puts $family_summary "family\tslack_ns\tfrom\tto"
+foreach {family from to} $families {
+    set args [list -setup -npaths 1]
+    if {[llength $from]} {
+        set regs [get_registers $from]
+        if {[get_collection_size $regs] == 0} { puts $family_summary "$family\tNO_SOURCE\t$from\t$to"; continue }
+        lappend args -from $regs
+    }
+    if {[llength $to]} {
+        set regs [get_registers $to]
+        if {[get_collection_size $regs] == 0} { puts $family_summary "$family\tNO_DESTINATION\t$from\t$to"; continue }
+        lappend args -to $regs
+    }
+    set paths [eval get_timing_paths $args]
+    if {[get_collection_size $paths] == 0} { puts $family_summary "$family\tNO_PATH\t$from\t$to"; continue }
+    foreach_in_collection path $paths {
+        puts $family_summary "$family\t[get_path_info -slack $path]\t[get_node_info -name [get_path_info -from $path]]\t[get_node_info -name [get_path_info -to $path]]"
+    }
+    eval report_timing $args [list -detail full_path -file build/timing5-families/$family.rpt]
+}
+close $family_summary
