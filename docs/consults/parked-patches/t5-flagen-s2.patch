 // Sequential logic.
 // -----------------------------------------------------------------------------
 
+// ARM925T: give the flags their own update enable. The original broad
+// output priority chain held them on faults, sleep, redirects, late waits
+// and failed conditions. Put those holds on this register's enable rather
+// than feeding the shared pipeline controls through its 32-bit D mux.
+// Writeback still replaces CPSR even during a data stall; reset wins.
+always_ff @(posedge i_clk) begin
+        if (i_reset) flags_ff <= CPSR_INIT;
+        else if (i_clear_from_writeback) flags_ff <= i_cpsr_nxt;
+        else if (!i_data_stall && !i_data_mem_fault && !sleep_ff &&
+                 !o_clear_from_alu && o_dav_nxt)
+                flags_ff <= flags_nxt;
+end
+
