+# Loaded after create_timing_netlist/read_sdc/update_timing_netlist.
+# Report matching register sets even when a family leaves the worst 30.
+# Empty from/to means unconstrained on that side.
+set found_corner 0
+foreach_in_collection corner [get_available_operating_conditions] {
+    if {[get_operating_conditions_info -display_name $corner] eq "Slow 1100mV 100C Model"} {
+        set_operating_conditions $corner
+        update_timing_netlist
+        set found_corner 1
+    }
+}
+if {!$found_corner} { error "Missing slow 100C corner" }
+set families {
+    icvalid_input {} {*u_code_cache*valid_s1* *u_code_cache*valid_part* *u_code_cache*lru_s1* *u_code_cache*lru_part* *u_code_cache*rd_hi_s1*}
+    icvalid_output {*u_code_cache*valid_s1* *u_code_cache*valid_part* *u_code_cache*lru_s1* *u_code_cache*lru_part* *u_code_cache*rd_hi_s1*} {*u_code_cache*valid_s2* *u_code_cache*lru_s2*}
+    dcvalid_input {} {*u_data_cache*valid_s1* *u_data_cache*valid_part* *u_data_cache*lru_s1* *u_data_cache*lru_part* *u_data_cache*rd_hi_s1*}
+    multiply {*u_zap_issue_main*o_alu_operation_ff* *u_zap_issue_main*o_alu_is_mult_ff*} {*u_zap_shifter_main*}
+    multiply_output {*u_zap_issue_main*o_alu_operation_ff* *u_zap_issue_main*o_alu_is_mult_ff*} {*u_zap_shifter_main|o_*}
+    dtlb_fault {*u_data_cache*u_zap_tlb_check*o_fsr*} {}
+    dtlb_fault_capture {} {*u_data_cache*u_zap_tlb_check*o_fsr*}
+    itlb_fault_capture {} {*u_code_cache*u_zap_tlb_check*o_fsr*}
+    dtlb_check_input {} {*u_data_cache*u_zap_tlb_check*o_fsr* *u_data_cache*u_zap_tlb_check*o_hit_ok*}
+    itlb_check_input {} {*u_code_cache*u_zap_tlb_check*o_fsr* *u_code_cache*u_zap_tlb_check*o_hit_ok*}
