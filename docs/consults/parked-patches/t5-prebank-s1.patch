+// ARM925T: prediction payloads have the same exact hold behavior as the
+// coprocessor payload below. Capture the next values into the unselected
+// bank; late pipeline control drives only the selector, not 64 enables.
+// A flush leaves the selected payload intact. The RAS pointer is unchanged.
+(* dont_retime *) logic [63:0] prediction0_ff, prediction1_ff;
+(* preserve, dont_retime *) logic prediction_select_ff;
+always_ff @(posedge i_clk) begin
+        if (i_reset) begin
+                prediction0_ff <= 64'b0;
+                prediction1_ff <= 64'b0;
+                prediction_select_ff <= 1'b0;
+        end else begin
+                if (prediction_select_ff)
+                        prediction0_ff <= {w_pc_from_decode, ppc_nxt};
+                else
+                        prediction1_ff <= {w_pc_from_decode, ppc_nxt};
+                if (!stall && !i_clear_from_writeback && !i_clear_from_alu &&
+                    !o_clear_from_decode && !mem_fetch_stall)
+                        prediction_select_ff <= !prediction_select_ff;
+        end
+end
+assign {o_pc_from_decode, o_ppc_ff} = prediction_select_ff ? prediction1_ff : prediction0_ff;
+
 // ARM925T: keep the CP15 payload's exact hold behavior using two banks.
 // Capture into the unselected bank; the late global stall controls only
 // the one-bit selector. CP15 may inspect the held word for many cycles.
