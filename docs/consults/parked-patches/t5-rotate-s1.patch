diff --git a/rtl/cpu/zap/zap_shifter_shift.sv b/rtl/cpu/zap/zap_shifter_shift.sv
index c0adb07..f32ce88 100644
--- a/rtl/cpu/zap/zap_shifter_shift.sv
+++ b/rtl/cpu/zap/zap_shifter_shift.sv
@@ -47,6 +47,13 @@ module zap_shifter_shift
 `include "zap_localparams.svh"
 
 logic signed [32:0] asr_res, asr_res_fin; // For ASR.
+// ARM925T: rotation is a five-bit barrel operation. Duplicating the source
+// avoids subtracting the amount from 32 and selecting a second variable
+// shift before ORing the results. Carry and zero-amount rules stay below.
+logic [63:0] rotated;
+logic unused_rotated;
+assign unused_rotated = |rotated[63:32];
+assign rotated = {i_source, i_source} >> i_amount[4:0];
 
 assign asr_res     = {i_source, i_carry};
 assign asr_res_fin = asr_res >>> i_amount;
@@ -69,8 +76,7 @@ begin
 
                 {1'd0, ROR}: // Rotate right.
                 begin
-                        o_result = ( i_source >> i_amount[4:0] )  |
-                                   ( i_source << (32 - i_amount[4:0] ) );
+                        o_result = rotated[31:0];
                         o_carry  = ( i_amount[7:0] == 0) ?
                                      i_carry  : ( (i_amount[4:0] == 0) ?
                                      i_source[31] : o_result[31] );
@@ -79,8 +85,7 @@ begin
                 RORI, ROR_1:
                 begin
                         // ROR #n (ROR_1)
-                        o_result = ( i_source >> i_amount[4:0] )  |
-                                   (i_source << (32 - i_amount[4:0] ) );
+                        o_result = rotated[31:0];
                         o_carry  = (|i_amount) ? o_result[31] : i_carry;
                 end
 
