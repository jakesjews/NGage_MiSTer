+++ b/rtl/cpu/zap/zap_predecode_main.sv
@@ -731,13 +731,10 @@ end
 //     UNDEFINED). In Thumb state the BL first half is a NOP with condition
 //     NV and stays one; the BLX suffix becomes BLX(1) (NV, 101).
 //
-always_comb
-begin: v5_classify
-        logic [34:0] x;
-        x          = o_instruction_nxt[34:0];
