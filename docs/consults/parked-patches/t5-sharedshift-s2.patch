-assign asr_res     = {i_source, i_carry};
-assign asr_res_fin = asr_res >>> i_amount;
+// ARM925T: share a five-level right barrel. Bit reversal implements LSL;
+// the upper word supplies zero/sign/rotate fill. Large non-rotate amounts
+// are handled separately, preserving the original carry at exactly 32.
+logic [31:0] reversed_source, shift_source, shift_fill, reversed_result;
+logic [64:0] barrel;
+logic rotate, arithmetic_right;
+logic unused;
+assign rotate = i_shift_type == {1'b0, ROR} ||
+                i_shift_type == RORI || i_shift_type == ROR_1;
+assign arithmetic_right = i_shift_type == {1'b0, ASR};
+for (genvar bitno = 0; bitno < 32; bitno++) begin : g_reverse
+        assign reversed_source[bitno] = i_source[31-bitno];
+        assign reversed_result[bitno] = barrel[32-bitno];
+end
+assign shift_source = i_shift_type == {1'b0, LSL} ? reversed_source : i_source;
+assign shift_fill = rotate ? i_source : {32{arithmetic_right && i_source[31]}};
+assign barrel = {shift_fill, shift_source, i_carry} >> i_amount[4:0];
+assign unused = |barrel[64:33];
 
 assign o_sat = i_shift_type == LSL_SAT ? (i_source[30] != i_source[31]) : 1'd0;
 
